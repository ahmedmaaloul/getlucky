# Every variable here is OPTIONAL.
#
# GetLucky reads public, key-free job APIs, so `npm install && npm run dev`
# gives you a working app with no .env file at all. These only unlock extras.

# ---------------------------------------------------------------------------
# Optional: AI query expansion — LEAVE THIS EMPTY ON A DEPLOYMENT
# ---------------------------------------------------------------------------
# Widens a search into related terms ("k8s" also finds "Kubernetes") and reads
# filters out of natural language ("senior rust roles in Berlin with visa").
#
# Running without it is the intended configuration, not a degraded one: the
# site serves live jobs with working filters and costs nothing to operate. Set
# it only for local use, and know that every search then bills your account.
#
# Agents connecting over MCP bring their own model, so this key does nothing
# for them.
#
# Free key if you do want it: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Optional: AI rate limiting
# ---------------------------------------------------------------------------
# Only the AI layer above is limited. Job search itself is never rate limited
# by us. Defaults are shown; raise them freely on your own deployment.
AI_REQUESTS_PER_VISITOR_PER_DAY=20
AI_VISITORS_PER_DAY=500

# Salt for the ephemeral daily visitor hash. Left unset, a random salt is
# generated per process — which is more private, at the cost of resetting
# counters on restart. Set it on a multi-instance deployment.
IP_SALT=

# ---------------------------------------------------------------------------
# Optional: identify yourself to upstream APIs
# ---------------------------------------------------------------------------
# Sent as the User-Agent on every outbound request. Being reachable is good
# manners when you are consuming someone's free API.
# GETLUCKY_USER_AGENT="YourApp/1.0 (+https://your-site.example)"

# ---------------------------------------------------------------------------
# Optional: your own scraper configurations
# ---------------------------------------------------------------------------
# Only read when you have added configs to lib/scraper/configs.local.ts AND set
# this to true. Each config launches a browser and they run one after another,
# so leaving it off keeps ordinary searches fast. You can always request the
# source explicitly instead, without this flag.
# ENABLE_CUSTOM_SCRAPERS=true
